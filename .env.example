# ==============================================================================
# NCC DATA COLLECTION & ORGANIZATION SYSTEM — ENVIRONMENT TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local for local development.
# 2. Fill in the placeholder values with actual project configuration.
# 3. NEVER commit real secrets or production keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE CLIENT CONFIGURATION (Publicly accessible in browser)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-firebase-app-id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# ------------------------------------------------------------------------------
# 2. FIREBASE ADMIN SDK CONFIGURATION (Server-side only — strictly confidential)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
# Note: Format multi-line private keys with literal \n escapes or wrap in quotes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. GOOGLE DRIVE API & SHARED DRIVE (Server-side only — document storage)
# ------------------------------------------------------------------------------
GOOGLE_DRIVE_CLIENT_EMAIL="drive-service-account@your-project-id.iam.gserviceaccount.com"
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
# ID of the Google Shared Drive owned by the NCC organizational unit
GOOGLE_DRIVE_SHARED_DRIVE_ID="your-shared-drive-id"
# Root folder inside the Shared Drive where cadet directories are provisioned
GOOGLE_DRIVE_ROOT_FOLDER_ID="your-cadet-root-folder-id"

GOOGLE_OAUTH_CLIENT_ID="your-client-id-here.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="your-client-secret-here"
# Delegated user OAuth refresh token (generated via scripts/authorize-drive.mjs)
GOOGLE_OAUTH_REFRESH_TOKEN=""

# ------------------------------------------------------------------------------
# 4. SMTP / EMAIL & OTP DISPATCH CONFIGURATION (Server-side only)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false" # Set "true" for port 465 (SSL), "false" for 587 (TLS/STARTTLS)
SMTP_USER="smtp-username-or-apikey"
SMTP_PASS="smtp-password-or-secret"
SMTP_FROM_EMAIL="ncc-system@organization.org"
SMTP_FROM_NAME="NCC Data System"

# ------------------------------------------------------------------------------
# 5. INITIAL SYSTEM BOOTSTRAP / SEED ADMIN
# ------------------------------------------------------------------------------
# The designated email address granted initial Admin role during system bootstrapping
SEED_ADMIN_EMAIL="admin@organization.org"

# ------------------------------------------------------------------------------
# 6. APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
